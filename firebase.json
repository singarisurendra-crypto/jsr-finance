{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.github/**",
      "**/.*",
      "**/node_modules/**",
      "*.bat",
      "*.zip",
      "*.gs",
      "*.md",
      "*.py"
    ],
    "redirects": [
      {
        "source": "**",
        "destination": "https://jsr-finance.pages.dev",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
